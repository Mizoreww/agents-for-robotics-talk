+        'enpire_demos': ('ENPIRE: Learned Manipulation Demos', demos, ['S15', 'ENPIRE_SITE']),
+        'enpire_transfer': ('ENPIRE: Experience Across Tasks', transfer, ['ENPIRE_TRANSFER', 'ENPIRE_SITE']),
